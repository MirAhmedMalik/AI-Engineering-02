# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill it in:    cp .env.example .env      (Windows: copy .env.example .env)
# ".env" is in .gitignore and must NEVER be committed, shared or pasted anywhere.
# The key is read by the Python backend only. It is not sent to the browser.
# The key is PERSONAL and limited (100 calls in total). If it leaks, it is revoked.
# ---------------------------------------------------------------------------

# Your personal OpenRouter key (given by the teacher). Not needed for Practice and Ollama modes.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Shown in the yellow bar on screen for the whole recording and saved in results.
STUDENT_NAME=Your Name
STUDENT_ROLL_NO=Your Roll Number

# ---- OpenRouter model IDs ----------------------------------------------------
MODEL_JEV=typesafe/jev-1.13
MODEL_LUNA=openai/gpt-6-luna-decisions
MODEL_CLEF=cloudflare/clef
MODEL_OPUS=anthropic/claude-haiku-5.5

# ---- Teacher's rules (enforced in the backend, not only in the page) -------------
MOVE_LIMIT=20                      # every model stops after 20 moves (= "not solved")
MAX_CLAUDE_REQUESTS=5              # Claude: at most 5 real requests in the whole experiment (so at most 5 moves)
MAX_REQUESTS_PER_DECISION_MODEL=20 # each decision model: at most 20 real requests
MAX_TOTAL_REQUESTS=65              # all models together (the code never allows more than 95)
MAX_COST_USD=0.30                  # hard money cap for the real OpenRouter run. 0 = no cap. A request is refused BEFORE it is sent if it could break the cap
COST_ESTIMATE_LLM_USD=0.01         # worst-case guess for one Claude request until a real price is seen
COST_ESTIMATE_DECISION_USD=0.002   # same for one decision-model request
MAX_ATTEMPTS=2                     # tries per move: first try + 1 retry. EVERY try is a real, counted request.

# ---- Wording of the question (same for EVERY model of a run) -----------------
# standard | compact | plain. Change it only if scripts/probe_luna.py finds a wording that stops Luna's refusal.
PROMPT_STYLE=standard

# ---- Other rules (same for every model) --------------------------------------
TRIAL_TIME_LIMIT_S=300     # OpenRouter: one model, one puzzle
REQUEST_TIMEOUT_S=90       # OpenRouter: one request
RETRY_BACKOFF_S=1          # doubles after every failed attempt
RECENT_MOVES_WINDOW=6      # how many of the last moves are sent as context

# Optional: ask the LLM to think before answering: low | medium | high. Empty = provider default.
OPUS_REASONING_EFFORT=
OPUS_MAX_TOKENS=4000       # 0 = do not set. A small number keeps Claude's answer (and price) short

# ---- Ollama (local models, free, no limit) --------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REQUEST_TIMEOUT_S=240
OLLAMA_TRIAL_TIME_LIMIT_S=900
OLLAMA_THINK=false                 # false = ask thinking models to answer directly (faster); empty = do not send
# Tags of the local models. Check what you have:  python scripts/check_models.py --backend ollama
OLLAMA_MODEL_CLEF=clef-flash       # decision model, served on /v1/systemone (about 11 GB; "clef" is the 27B one)
OLLAMA_MODEL_QWEN=qwen3:4b
OLLAMA_MODEL_DEEPSEEK=deepseek-r1:1.5b
OLLAMA_MODEL_GEMMA=gemma3:4b

# ---- Where the request counters and the cache are saved ----------------------------
# Do NOT delete this folder between runs: the counters and the cache must survive restarts.
DATA_DIR=
RESULTS_DIR=

# ---- Server ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Practice mode only: 1.0 = realistic waiting times, 0 = instant
MOCK_LATENCY_SCALE=1.0
